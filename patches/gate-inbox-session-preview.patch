+func (s *sessions) Preview(ctx context.Context, id string) (extension.SessionPreview, error) {
+	if err := ctx.Err(); err != nil {
+		return extension.SessionPreview{}, err
+	}
+	if !s.operator {
+		return extension.SessionPreview{}, errors.New("only the operator can read a session preview")
+	}
+	return s.cmds.Preview(id)
+}
