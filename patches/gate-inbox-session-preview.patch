+package ui
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"unicode"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/usestring/gate-inbox/extension"
+	"github.com/usestring/gate-inbox/internal/dialog"
+	"github.com/usestring/gate-inbox/internal/search"
+)
+
+func (m *Model) previewSource(role string) func(string) (extension.SessionPreview, error) {
+	if role != "" {
+		for _, ui := range m.extUIs {
+			if ui.PreviewRole == role {
+				return ui.ReadPreview
+			}
+		}
+	}
+	return nil
+}
+
+func (c *conversationView) readPreview(id, key string, read func(string) (extension.SessionPreview, error)) tea.Cmd {
+	c.pendingKey = key
+	c.previewRead++
+	request := c.previewRead
+	previous := c.preview
+	sameRow := c.key == key && c.err == nil
+	return func() (out tea.Msg) {
+		msg := conversationMsg{key: key, previewRead: request}
+		defer func() {
+			if recover() != nil {
+				msg.err = fmt.Errorf("extension preview failed")
+				out = msg
+			}
+		}()
+		preview, err := read(id)
+		msg.preview, msg.err = &preview, err
+		if err == nil {
+			msg.unchanged = sameRow && reflect.DeepEqual(previous, &preview)
+			if !msg.unchanged {
+				for _, message := range preview.Messages {
+					msg.messages = append(msg.messages, search.Message{Role: message.Role, Text: message.Text})
+				}
+			}
+		}
+		return msg
+	}
+}
+
+func (m *Model) extensionPreviewCard(preview *extension.PreviewDialog, width, height int) []string {
+	if preview == nil {
+		return nil
+	}
+	c := &m.screenCard
+	if c.extension == preview && c.width == width && c.height == height && c.theme == renderGen {
+		return c.lines
+	}
+	clean := func(text string) string {
+		return strings.Map(func(r rune) rune {
+			if unicode.IsControl(r) {
+				return ' '
+			}
+			return r
+		}, ansi.Strip(text))
+	}
+	screen := dialog.Screen{Kind: dialog.ScreenKind(clean(preview.Kind))}
+	for _, line := range preview.Lines {
+		screen.Lines = append(screen.Lines, clean(line))
+	}
+	for _, choice := range preview.Choices {
+		screen.Choices = append(screen.Choices, dialog.ScreenChoice{Label: clean(choice.Label), Cursor: choice.Cursor})
+	}
+	*c = screenCard{extension: preview, width: width, height: height, theme: renderGen,
+		lines: fitScreenCard(screen, width, height)}
+	return c.lines
+}
