+package sessioncmd
+
+import (
+	"slices"
+
+	"github.com/usestring/gate-inbox/extension"
+	"github.com/usestring/gate-inbox/extension/textfmt"
+	"github.com/usestring/gate-inbox/internal/dialog"
+	"github.com/usestring/gate-inbox/internal/migrate"
+	"github.com/usestring/gate-inbox/internal/opencode"
+	"github.com/usestring/gate-inbox/internal/search"
+)
+
+// Preview reads the inputs to the board's conversation view on the operator's behalf.
+func (s *Sessions) Preview(id string) (extension.SessionPreview, error) {
+	runtime, err := s.open()
+	if err != nil {
+		return extension.SessionPreview{}, err
+	}
+	defer runtime.store.Close()
+	target, err := runtime.agent(id)
+	if err != nil {
+		return extension.SessionPreview{}, err
+	}
+	if err := runtime.reach(target); err != nil {
+		return extension.SessionPreview{}, err
+	}
+	var preview extension.SessionPreview
+	if !target.Archived && runtime.driver.Exists(id) {
+		if pane, err := runtime.driver.CapturePane(id); err == nil {
+			if screen, ok := dialog.ReadScreenFor(target.Tool, pane); ok {
+				preview.Dialog = &extension.PreviewDialog{Kind: string(screen.Kind), Lines: screen.Lines}
+				for _, choice := range screen.Choices {
+					preview.Dialog.Choices = append(preview.Dialog.Choices, extension.PreviewChoice{Label: choice.Label, Cursor: choice.Cursor})
+				}
+			}
+		}
+	}
+	locator := search.NewLocator(s.roots.ClaudeHome, s.roots.CodexRoot)
+	format := migrate.HistoryFormat(target.Tool, runtime.cfg.Tools[target.Tool])
+	if source, ok := locator.Target(id, format, target.Cwd, target.AgentSessionID); ok {
+		messages, err := search.ReadMessages(source, opencode.DBPath())
+		if err == nil {
+			// Cap the bytes sent over SSH and keep the newest messages.
+			const limit = 256 << 10
+			remaining := limit
+			for i := len(messages) - 1; i >= 0 && remaining > 64; i-- {
+				message := messages[i]
+				text := textfmt.Tail(message.Text, remaining-64)
+				preview.Messages = append(preview.Messages, extension.PreviewMessage{Role: message.Role, Text: text})
+				remaining -= len(text) + 64
+			}
+			slices.Reverse(preview.Messages)
+		}
+	}
+	return preview, nil
+}
