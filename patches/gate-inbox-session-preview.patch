+package extension
+
+import "context"
+
+// PreviewSource supplies the conversation view for sessions with Role,
+// the unqualified name of one of the extension's roles.
+type PreviewSource struct {
+	Role string
+	// Read runs off the event loop while a session is selected. The
+	// returned dialog is read-only.
+	Read func(ctx context.Context, sessionID string) (SessionPreview, error)
+}
+
+// SessionPreview holds user-facing messages and the current dialog, if any.
+type SessionPreview struct {
+	Messages []PreviewMessage `json:"messages,omitempty"`
+	Dialog   *PreviewDialog   `json:"dialog,omitempty"`
+}
+
+type PreviewMessage struct {
+	Role string `json:"role"`
+	Text string `json:"text"`
+}
+
+type PreviewDialog struct {
+	Kind    string          `json:"kind"`
+	Lines   []string        `json:"lines"`
+	Choices []PreviewChoice `json:"choices,omitempty"`
+}
+
+type PreviewChoice struct {
+	Label  string `json:"label"`
+	Cursor bool   `json:"cursor,omitempty"`
+}
+
+// PreviewReader is implemented by the operator's CLI session service.
+type PreviewReader interface {
+	Preview(ctx context.Context, id string) (SessionPreview, error)
+}
